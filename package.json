{
  "name": "leetcode-autocommit-extension",
  "version": "1.0.0",
  "description": "Chrome extension to automatically commit LeetCode solutions to GitHub",
  "main": "manifest.json",
  "scripts": {
    "build": "echo 'No build process needed for Chrome extension'",
    "test": "echo 'Open chrome://extensions/ and load unpacked'",
    "package": "zip -r leetcode-autocommit.zip . -x '*.git*' 'node_modules/*' '*.DS_Store'"
  },
  "keywords": [
    "chrome-extension",
    "leetcode",
    "github",
    "automation",
    "coding"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/leetcode-autocommit-extension"
  },
  "bugs": {
    "url": "https://github.com/yourusername/leetcode-autocommit-extension/issues"
  },
  "homepage": "https://github.com/yourusername/leetcode-autocommit-extension#readme",
  "devDependencies": {},
  "dependencies": {}
} 