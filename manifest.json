{
  "manifest_version": 3,
  "name": "LeetCode AutoCommit to GitHub",
  "version": "1.0.0",
  "description": "Automatically commits accepted LeetCode solutions to GitHub",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetCode GitHub Config"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
} 