    {
      "id": 7,
      "title": "API error rates",
      "type": "timeseries",
      "description": "Server and client errors shown separately. Missing error series are zero; scrape health is displayed above.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum(rate(http_server_requests_seconds_count{job=\"incidentiq-api\",uri!~\"/actuator.*\",status=~\"5..\"}[$__rate_interval]))) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"incidentiq-api\",uri!~\"/actuator.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "server 5xx",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "100 * ((sum(rate(http_server_requests_seconds_count{job=\"incidentiq-api\",uri!~\"/actuator.*\",status=~\"4..\"}[$__rate_interval]))) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"incidentiq-api\",uri!~\"/actuator.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "client 4xx",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code"
