COMPOSE_PROJECT_NAME=incidentiq
POSTGRES_DB=incidentiq
POSTGRES_USER=incidentiq
POSTGRES_PASSWORD=incidentiq_local_only
POSTGRES_PORT=55432
KAFKA_PORT=9092
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=incidentiq_local_only
API_PORT=8080

# none: persist explicitly labeled retrieved evidence without generative analysis.
LLM_PROVIDER=none
# ollama: set to an already-installed local model; models are never auto-pulled.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=30

FRONTEND_PORT=5173
